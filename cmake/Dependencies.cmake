set(SPY_ENGINE_DEPS "")

function(spy_add_vendored name dir)
    if(EXISTS "${CMAKE_SOURCE_DIR}/third_party/${dir}/CMakeLists.txt")
        message(STATUS "SpyEngine: using vendored ${name} from third_party/${dir}")
        add_subdirectory("${CMAKE_SOURCE_DIR}/third_party/${dir}"
                         "${CMAKE_BINARY_DIR}/third_party/${dir}")
    else()
        message(STATUS "SpyEngine: third_party/${dir} is empty - skipping ${name}")
    endif()
endfunction()

if(SPY_ENABLE_VULKAN)
    find_package(Vulkan QUIET)
    if(Vulkan_FOUND)
        message(STATUS "SpyEngine: Vulkan found (${Vulkan_VERSION})")
        list(APPEND SPY_ENGINE_DEPS Vulkan::Vulkan)
    else()
        message(STATUS "SpyEngine: Vulkan not found - renderer backend disabled")
    endif()
endif()

find_package(SDL2 QUIET)
if(SDL2_FOUND)
    message(STATUS "SpyEngine: SDL2 found")
    list(APPEND SPY_ENGINE_DEPS SDL2::SDL2)
else()
    message(STATUS "SpyEngine: SDL2 not found - drop it in third_party/SDL or install it")
endif()

spy_add_vendored(glm                   glm)
spy_add_vendored(EnTT                  entt)
spy_add_vendored(box2d                 box2d)
spy_add_vendored(miniaudio             miniaudio)
spy_add_vendored(VulkanMemoryAllocator VulkanMemoryAllocator)

if(TARGET glm::glm)
    list(APPEND SPY_ENGINE_DEPS glm::glm)
endif()
if(TARGET EnTT::EnTT)
    list(APPEND SPY_ENGINE_DEPS EnTT::EnTT)
endif()
if(TARGET box2d::box2d)
    list(APPEND SPY_ENGINE_DEPS box2d::box2d)
endif()

list(REMOVE_DUPLICATES SPY_ENGINE_DEPS)
set(SPY_ENGINE_DEPS "${SPY_ENGINE_DEPS}" CACHE INTERNAL "Resolved third-party targets")
